# VOXIA AI backend environment example
# Keep real credentials out of Git. Configure these in Vercel Environment Variables.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-14b
OPENROUTER_APP_URL=https://YOUR-FRONTEND-DOMAIN.vercel.app
OPENROUTER_APP_NAME=VOXIA AI

# Supabase PostgreSQL connection string. Prefer the Session pooler for serverless.
# Copy it from Supabase Dashboard -> Connect -> Session pooler.
# Example format only; substitute your project host, username, and password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
EMBEDDING_DIM=768
VECTOR_INDEX_METHOD=hnsw

CORS_ORIGINS=https://YOUR-FRONTEND-DOMAIN.vercel.app
FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN.vercel.app
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=700
LLM_MAX_HISTORY_MESSAGES=16
LLM_TEMPERATURE=0.65

# Optional Google OAuth settings, if Google login is enabled:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-BACKEND-DOMAIN.vercel.app/api/auth/google/callback
