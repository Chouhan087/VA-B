# OpenRouter API (create a key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=VOXIA AI
OPENROUTER_APP_URL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=700
LLM_MAX_HISTORY_MESSAGES=16
LLM_TEMPERATURE=0.65

# Database: use managed PostgreSQL for cloud hosting (SQLite files are ephemeral on serverless).
DATABASE_URL=sqlite:///./voxia.db
EMBEDDING_DIM=768
VECTOR_INDEX_METHOD=hnsw

# Generate a unique secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Google OAuth; configure exact production callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
